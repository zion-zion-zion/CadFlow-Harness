# OpenAI-compatible API endpoint, for example: https://api.openai.com/v1
OPENAI_BASE_URL=

# Model identifier exposed by the API provider
OPENAI_MODEL_ID=

# Reasoning effort: none uses Chat Completions; low/medium/high/max use Responses
OPENAI_REASONING_EFFORT=medium

# Optional Responses reasoning summary: auto, concise, or detailed
OPENAI_REASONING_SUMMARY=

# Copy this file to .env and replace the placeholder with your API key
OPENAI_API_KEY=

# Optional multi-turn retention limits
CADFLOW_CONVERSATION_MAX_CONTEXT_CHARS=200000
CADFLOW_ARTIFACT_VERSION_LIMIT=10

# Per-Agent Run wall-clock budget in seconds; restart the backend after changing it
CADFLOW_AGENT_RUN_TIMEOUT_SECONDS=1200
